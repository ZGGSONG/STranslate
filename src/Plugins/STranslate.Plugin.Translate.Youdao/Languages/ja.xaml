<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Info">紹介</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Info_Content">このプラグインは公式のYoudao翻訳APIを使用して翻訳を行います。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_AppKey">AppKey</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_AppSecret">AppSecret</sys:String>

    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_MissingParameter">必須パラメーターが不足しているか、パラメーター名が正しくありません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedLanguage">この言語には対応していません。別の言語を選択してください。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_TextTooLong">翻訳するテキストが長すぎます。分割して翻訳してください。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedApi">指定された API の種類には対応していません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedSignature">この署名方式には対応していません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedResponse">この応答形式には対応していません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedEncryption">この通信暗号化方式には対応していません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidAppId">アプリケーション ID が無効です。AppKey と有道コンソールのサービス連携設定を確認してください。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidBatchLog">batchLog パラメーターの形式が正しくありません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_ServiceNotBound">アプリケーションに有効なサービスが紐付けられていません。有道コンソールで設定を確認してください。読み上げには音声合成サービスの紐付けも必要です。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidAccount">開発者アカウントが無効です。アカウントの状態を確認してください。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidService">指定されたサービスが無効です。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_EmptyText">翻訳するテキストを入力してください。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedImageTransfer">この画像転送方式には対応していません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidStrict">strict パラメーターには true または false を指定してください。</sys:String>
