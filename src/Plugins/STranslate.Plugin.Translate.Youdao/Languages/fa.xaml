<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Info">معرفی</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Info_Content">این افزونه از API رسمی ترجمه Youdao استفاده می‌کند.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_AppKey">شناسه برنامه (AppKey)</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_AppSecret">کلید محرمانه برنامه (AppSecret)</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_MissingParameter">پارامترهای الزامی درخواست وجود ندارند یا نام آن‌ها نادرست است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedLanguage">این زبان پشتیبانی نمی‌شود. زبان دیگری انتخاب کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_TextTooLong">متن از حد مجاز طول ترجمه بیشتر است. آن را به بخش‌های کوچک‌تر تقسیم کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedApi">نوع API درخواستی پشتیبانی نمی‌شود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedSignature">این نوع امضا پشتیبانی نمی‌شود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedResponse">این قالب پاسخ پشتیبانی نمی‌شود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedEncryption">این نوع رمزگذاری انتقال پشتیبانی نمی‌شود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidAppId">شناسهٔ برنامه نامعتبر است. AppKey و اتصال سرویس‌ها به برنامه را در کنسول Youdao بررسی کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidBatchLog">قالب پارامتر batchLog نامعتبر است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_ServiceNotBound">هیچ سرویس معتبری به این برنامه متصل نیست. اتصال سرویس‌ها را در کنسول Youdao بررسی کنید؛ پخش تلفظ به سرویس تبدیل متن به گفتار نیز نیاز دارد.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidAccount">حساب توسعه‌دهنده نامعتبر است. وضعیت حساب را بررسی کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidService">سرویس درخواستی نامعتبر است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_EmptyText">متنی برای ترجمه وارد کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedImageTransfer">این روش انتقال تصویر پشتیبانی نمی‌شود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidStrict">مقدار پارامتر strict باید true یا false باشد.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_RequestDecryption">رمزگشایی درخواست ناموفق بود. DES، Base64 یا کدگذاری URL را بررسی کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidSignature">اعتبارسنجی امضا ناموفق بود. AppKey و AppSecret را بررسی کنید، سپس مطمئن شوید که متن از کدگذاری UTF-8 استفاده می‌کند.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_IpDenied">نشانی IP خروجی مجاز نیست. فهرست IPهای مجاز را در کنسول Youdao بررسی کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_PlatformMismatch">پلتفرم برنامه با رابط درخواستی مطابقت ندارد. مطمئن شوید که برنامه برای دسترسی از طریق API تنظیم شده است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidTimestamp">به دلیل نامعتبر بودن برچسب زمانی، اعتبارسنجی امضا ناموفق بود. تاریخ و ساعت سیستم Windows را همگام‌سازی کرده و دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_Replay">درخواست به‌عنوان درخواست تکراری رد شد. ترجمهٔ جدیدی را آغاز کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_DictionaryFailed">جست‌وجو در واژه‌نامه ناموفق بود. بعداً دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_TranslationQueryFailed">درخواست ترجمه ناموفق بود. بعداً دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_ServiceError">خطایی در سرویس Youdao رخ داد. بعداً دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_TranslationFailed">ترجمه ناموفق بود. با پشتیبانی فنی Youdao تماس بگیرید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidFallback">پارامتر rejectFallback نامعتبر است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidDomain">پارامتر domain نامعتبر است. حوزهٔ ترجمه را بررسی کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_DomainNotEnabled">ترجمهٔ تخصصی فعال نیست. آن را در کنسول Youdao فعال کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InsufficientBalance">موجودی حساب Youdao کافی نیست. حساب را شارژ کرده و دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_OfflineUnavailable">SDK آفلاین در دسترس نیست.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_RateLimited">تعداد درخواست‌ها از حد مجاز بیشتر شده است. بعداً دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_LongRequestRateLimited">درخواست‌های متن طولانی بیش از حد مکرر هستند. بعداً دوباره تلاش کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_InvalidOcr">نوع OCR نامعتبر است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedOcrImage">این نوع تصویر OCR پشتیبانی نمی‌شود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Youdao_Error_UnsupportedOcrLanguage">این زبان تشخیص OCR پشتیبانی نمی‌شود.</sys:String>
